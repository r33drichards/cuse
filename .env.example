# Copy to .env locally; do not commit secrets. Railway: use secret references.
IRC_SERVER=irc.example.net
IRC_PORT=6697
IRC_TLS=true
# Prefix for stable per-channel petnames, for example cuse-settling-mayfly.
IRC_NICK=cuse
IRC_CONTROL_CHANNEL='#cuse'
IRC_CHANNELS=
IRC_RESPOND_TO_ALL=false
# IRC_PASSWORD is unsupported by the WeeChat bootstrap and fails startup.
# Full native command/read access by default. Explicit 0 restores restricted mode.
WEECHAT_MCP_FULL_CONTROL=1
# Startup peer channels; also the buffer allowlist in restricted mode.
CUSE_WEECHAT_PEERS={}
# Local development only: set paths to vendored upstream and its Python venv.
# CUSE_WEECHAT_DIR=/absolute/path/to/cuse/vendor/weechat-mcp
# CUSE_WEECHAT_PYTHON=/absolute/path/to/weechat/venv/bin/python
# Required. Insert securely, never bake into image/build args.
COMPUTERUSE_API_TOKEN=
COMPUTERUSE_API_URL=https://api.computeruse.site
COMPUTERUSE_APP_URL=https://app.computeruse.site
COMPUTERUSE_SESSION_SIZE=small
CUSE_MAX_DESKTOPS=10
# Optional stable namespace (otherwise Railway service ID, then server:port:nick).
CUSE_INSTANCE_ID=
# ChatGPT account OAuth: private admin /login, persisted /data/agent/auth.json.
# This is NOT OpenAI API-key billing. Do not import pi-irc provider secrets.
PI_DEFAULT_PROVIDER=openai-codex
PI_DEFAULT_MODEL=gpt-5.4
# Alternate providers require an explicit admin choice and separate billing.
# No API-key fallback is configured. Never put OAuth tokens in this env file.
# Optional JSON object; mounted /config/models.json takes precedence.
PI_MODELS_JSON=

# Required for native server-ID replay. Read the migration gate before upgrading.
CUSE_DURABLE_IRC=true

# Pi Goal durable port; requires CUSE_DURABLE_IRC=true.
CUSE_GOALS_ENABLED=false

# Native WeeChat intake requires durable receipts (CUSE_DURABLE_IRC=true).
# ONE-TIME MIGRATION ONLY: choose a reviewed UTC cutoff after backing up the
# volume. Retained history at/before it will not execute, even if never processed.
# No default is selected. The chosen value persists in the receipt database.
# CUSE_WEECHAT_HISTORY_AFTER=2026-01-01T00:00:00.000Z
